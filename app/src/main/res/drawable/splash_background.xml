<?xml version="1.0" encoding="utf-8"?>
<!--
    Cold start window background: the app colour with the Lunara logo centred on it.
    It is what the launcher shows while the process comes up, so the brand is visible
    before Compose draws anything.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/lunara_background" />
    <item>
        <bitmap
            android:antialias="true"
            android:gravity="center"
            android:src="@drawable/lunara_logo" />
    </item>
</layer-list>
